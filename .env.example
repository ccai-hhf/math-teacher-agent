# 三选一填写：Kimi / OpenAI / Anthropic
# 优先使用 KIMI_API_KEY，其次是 OPENAI_API_KEY，最后是 ANTHROPIC_API_KEY

# ===== Kimi（推荐国内使用）=====
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k-vision-preview

# ===== OpenAI 兼容 API =====
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ===== Anthropic Claude =====
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GRADER_MODEL=claude-sonnet-4-5-20250929

# 可选：控制模型输出长度
# GRADER_MAX_TOKENS=16000
